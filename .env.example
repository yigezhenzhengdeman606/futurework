# Node runtime: set PORT in your shell or Replit Secrets.
# .env is not automatically loaded (no dotenv dependency).
PORT=3000
# Platform-funded trial: server secrets only; never add them to public/.
DEEPSEEK_API_KEY=
TRIAL_SIGNING_KEY=
FREE_TRIAL_ENABLED=false
# Optional legacy RunPod template settings; not used by the web MVP.
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id
